<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.themirachathumina.golangintellijcommunity</id>
    <name>Go-Lang-Community</name>
    <vendor>themirachathumina</vendor>
    <incompatible-with>com.intellij.modules.ultimate</incompatible-with>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <depends optional="true" config-file="coverage.xml">com.intellij.modules.coverage</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>


    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.github.themirachathumina.golangintellijcommunity.settings.GoAppSettings"/>
        <projectService
                serviceImplementation="com.github.themirachathumina.golangintellijcommunity.run.test.GoTestResultsService"/>
        <applicationConfigurable
                parentId="language"
                instance="com.github.themirachathumina.golangintellijcommunity.settings.GoLanguageConfigurable"
                id="com.github.themirachathumina.golangintellijcommunity.settings.GoLanguageConfigurable"
                displayName="Go"/>

        <fileType name="Go File"
                  implementationClass="com.github.themirachathumina.golangintellijcommunity.GoFileType"
                  fieldName="INSTANCE"
                  language="Go"
                  extensions="go"/>
        <lang.parserDefinition language="Go"
                               implementationClass="com.github.themirachathumina.golangintellijcommunity.GoParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Go"
                                     implementationClass="com.github.themirachathumina.golangintellijcommunity.highlight.GoSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.github.themirachathumina.golangintellijcommunity.highlight.GoColorSettingsPage"/>
        <annotator
                language="Go"
                implementationClass="com.github.themirachathumina.golangintellijcommunity.highlight.GoFormatVerbAnnotator"/>
        <multiHostInjector implementation="com.github.themirachathumina.golangintellijcommunity.highlight.GoRegExpInjector"/>
        <annotator language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.highlight.GoSemanticAnnotator"/>
        <annotator language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.highlight.GoEscapeSequenceAnnotator"/>

        <lang.foldingBuilder language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.ide.GoFoldingBuilder"/>
        <lang.commenter language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.ide.GoCommenter"/>
        <highlightErrorFilter implementation="com.github.themirachathumina.golangintellijcommunity.highlight.GoHighlightErrorFilter"/>
        <lang.braceMatcher language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.ide.GoPairedBraceMatcher"/>
        <lang.quoteHandler language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.ide.GoQuoteHandler"/>
        <spellchecker.support language="Go" implementationClass="com.github.themirachathumina.golangintellijcommunity.ide.GoSpellcheckingStrategy"/>

        <editorNotificationProvider implementation="com.github.themirachathumina.golangintellijcommunity.sdk.GoSdkEditorNotificationProvider"/>
        <postStartupActivity implementation="com.github.themirachathumina.golangintellijcommunity.sdk.GoSdkAutoDetector"/>
        <statusBarWidgetFactory id="GoSdkStatusBarWidgetFactory" implementation="com.github.themirachathumina.golangintellijcommunity.sdk.GoSdkStatusBarWidgetFactory"/>

        <newProjectWizard.generator implementation="com.github.themirachathumina.golangintellijcommunity.wizard.GoNewProjectWizard"/>
        <configurationType implementation="com.github.themirachathumina.golangintellijcommunity.run.GoRunConfigurationType"/>
        <configurationType implementation="com.github.themirachathumina.golangintellijcommunity.run.test.GoTestRunConfigurationType"/>
        <!-- LSP textDocument/signatureHelp -->
        <codeInsight.parameterInfo
                language="Go"
                implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>

        <!-- LSP textDocument/documentSymbol -->
        <lang.psiStructureViewFactory
                language="Go"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>

        <runConfigurationProducer implementation="com.github.themirachathumina.golangintellijcommunity.run.GoFileRunConfigurationProducer"/>
        <runConfigurationProducer implementation="com.github.themirachathumina.golangintellijcommunity.run.GoPackageRunConfigurationProducer"/>
        <runConfigurationProducer implementation="com.github.themirachathumina.golangintellijcommunity.run.test.GoTestRunConfigurationProducer"/>
        <runLineMarkerContributor
                language="Go"
                implementationClass="com.github.themirachathumina.golangintellijcommunity.run.GoRunLineMarkerContributor"/>
        <runLineMarkerContributor
                language="Go"
                implementationClass="com.github.themirachathumina.golangintellijcommunity.run.test.GoTestRunLineMarkerContributor"/>

        <testFinder implementation="com.github.themirachathumina.golangintellijcommunity.run.test.GoTestFinder"/>

        <stepsBeforeRunProvider implementation="com.github.themirachathumina.golangintellijcommunity.run.GoGenerateBeforeRunTaskProvider"/>
        <stepsBeforeRunProvider implementation="com.github.themirachathumina.golangintellijcommunity.run.GoModTidyBeforeRunTaskProvider"/>

        <console.folding implementation="com.github.themirachathumina.golangintellijcommunity.run.GoConsoleFolding"/>

        <notificationGroup id="Go Plugin Notifications" displayType="BALLOON"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/GoDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/GoDarcula.xml"/>
        <additionalTextAttributes scheme="High contrast" file="colorSchemes/GoHighContrast.xml"/>
        <additionalTextAttributes scheme="Classic Light" file="colorSchemes/GoClassicLight.xml"/>

        <!-- go.mod / go.work file type -->
        <fileType name="Go Module File"
                  implementationClass="com.github.themirachathumina.golangintellijcommunity.gomod.GoModFileType"
                  fieldName="INSTANCE"
                  language="GoMod"
                  fileNames="go.mod;go.work;go.sum"/>
        <fileTypeDetector implementation="com.github.themirachathumina.golangintellijcommunity.gomod.GoModFileTypeDetector"/>
        <lang.parserDefinition language="GoMod"
                               implementationClass="com.github.themirachathumina.golangintellijcommunity.gomod.GoModParserDefinition"/>
        <lang.syntaxHighlighterFactory language="GoMod"
                                       implementationClass="com.github.themirachathumina.golangintellijcommunity.gomod.GoModSyntaxHighlighterFactory"/>
        <lang.commenter language="GoMod"
                        implementationClass="com.github.themirachathumina.golangintellijcommunity.gomod.GoModCommenter"/>
        <lang.foldingBuilder language="GoMod"
                             implementationClass="com.github.themirachathumina.golangintellijcommunity.gomod.GoModFoldingBuilder"/>
        <editorNotificationProvider implementation="com.github.themirachathumina.golangintellijcommunity.gomod.GoSumEditorNotificationProvider"/>
        <fileIconProvider implementation="com.github.themirachathumina.golangintellijcommunity.gomod.GoModFileIconProvider"/>
    </extensions>

    <actions>
        <action id="Go.NewGoFile"
                class="com.github.themirachathumina.golangintellijcommunity.ide.actions.GoCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>

        <!-- Tools > Go > Clean Test Cache -->
        <group id="Go.ToolsMenu" text="Go" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Go.CleanTestCache"
                    class="com.github.themirachathumina.golangintellijcommunity.run.test.GoCleanTestCacheAction"
                    text="Clean Go Test Cache"
                    description="Runs 'go clean -testcache' to invalidate the test result cache"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="gopls"
                name="Go Language Server"
                factoryClass="com.github.themirachathumina.golangintellijcommunity.lsp.GoLanguageServerFactory"/>

        <languageMapping language="Go"    serverId="gopls"/>
        <languageMapping language="GoMod" serverId="gopls"/>
        <fileTypeMapping fileType="Go Module File" serverId="gopls"/>
        <semanticTokensColorsProvider
                serverId="gopls"
                class="com.github.themirachathumina.golangintellijcommunity.highlight.GoSemanticTokensColorsProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.themirachathumina.golangintellijcommunity.sdk.GoLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

</idea-plugin>
